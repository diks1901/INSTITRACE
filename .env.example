# INSTITRACE local configuration example.
# Copy to .env and adjust. NEVER commit a real .env file.

# ---- Database -------------------------------------------------------------
# SQLite fallback (default, fully self-contained; relative paths resolve
# against the backend/ working directory):
INSTITRACE_DATABASE_URL=sqlite:///./institrace.db
# PostgreSQL (primary target). Example only - create the database first:
# INSTITRACE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/institrace

# ---- Deadline thresholds (PROTOTYPE DEFAULTS - not official AICTE SLAs) ---
INSTITRACE_DEADLINE_WARNING_DAYS=3
INSTITRACE_ESCALATION_OVERDUE_DAYS=7

# ---- App ------------------------------------------------------------------
INSTITRACE_APP_VERSION=0.1.0
INSTITRACE_RULE_ENGINE_VERSION=1.0.0

# Demo auth signing secret - CHANGE for anything beyond a local demo.
INSTITRACE_SECRET_KEY=DEMO-INSECURE-SECRET-change-me

# CORS origins allowed to call the API (comma separated)
INSTITRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Demo user passwords (defaults used ONLY when these are not set) ------
# These defaults exist so a local demo works out of the box. Override them in
# .env before sharing the stack beyond localhost.
INSTITRACE_DEMO_ADMIN_PASSWORD=InstiTrace#Demo1
INSTITRACE_DEMO_OFFICER_PASSWORD=Officer#Demo1
INSTITRACE_DEMO_REVIEWER_PASSWORD=Reviewer#Demo1
INSTITRACE_DEMO_MANAGER_PASSWORD=Manager#Demo1
